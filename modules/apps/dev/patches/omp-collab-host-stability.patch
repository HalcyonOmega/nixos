+++ b/packages/coding-agent/test/collab/host-history-tail.test.ts
@@ -0,0 +1,228 @@
+/**
+ * Contract: a joining guest receives only the latest history (bounded by
+ * `collab.historyEntries` and a byte budget) re-rooted onto a marker entry,
+ * the mirrored roster carries live agents plus a few recent finished ones
+ * instead of every agent the session ever spawned, and superseded live
+ * frames are coalesced in the host's send queue.
+ */
+import { afterEach, beforeEach, describe, expect, it, spyOn, vi } from "bun:test";
+import { COLLAB_HISTORY_OMITTED_CUSTOM_TYPE, CollabHost } from "@oh-my-pi/pi-coding-agent/collab/host";
+import { type AgentSnapshot, COLLAB_PROTO, type CollabFrame } from "@oh-my-pi/pi-coding-agent/collab/protocol";
+import { CollabSocket } from "@oh-my-pi/pi-coding-agent/collab/relay-client";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import type { InteractiveModeContext } from "@oh-my-pi/pi-coding-agent/modes/types";
+import { AgentRegistry } from "@oh-my-pi/pi-coding-agent/registry/agent-registry";
+import type { SessionEntry } from "@oh-my-pi/pi-coding-agent/session/session-entries";
+import { installInMemoryRelay, uninstallInMemoryRelay } from "./helpers/in-memory-relay";
+
+function makeCtx(entries: SessionEntry[], overrides: Record<string, unknown> = {}): InteractiveModeContext {
+	const sessionId = `sess-${crypto.randomUUID()}`;
+	return {
+		settings: Settings.isolated(overrides),
+		sessionManager: {
+			getSessionId: () => sessionId,
+			getCwd: () => "/tmp/collab-history-test",
+			snapshotForReplication: () => ({
+				header: { type: "session", id: sessionId, timestamp: "2026-07-20T00:00:00Z", cwd: "/tmp" },
+				entries,
+			}),
+			onEntryAppended: undefined,
+		},
+		session: {
+			isSessionTransitioning: false,
+			isStreaming: false,
+			queuedMessageCount: 0,
+			sessionName: "history-test",
+			model: undefined,
+			thinkingLevel: undefined,
+			subscribe: () => () => {},
+			emitNotice: () => {},
+			promptCustomMessage: () => Promise.resolve(),
+			abort: () => Promise.resolve(),
+		},
+		eventBus: undefined,
+		statusLine: {
+			setCollabStatus: () => {},
+			invalidate: () => {},
+			getCachedContextBreakdown: () => ({ usedTokens: 0, contextWindow: 0 }),
+		},
+		ui: { requestRender: () => {} },
+		showStatus: () => {},
+		collabHost: undefined,
+	} as unknown as InteractiveModeContext;
+}
+
+function chain(count: number, contentBytes = 8): SessionEntry[] {
+	const entries: SessionEntry[] = [];
+	for (let i = 0; i < count; i++) {
+		entries.push({
+			type: "custom_message",
+			id: `e${i}`,
+			parentId: i === 0 ? null : `e${i - 1}`,
+			timestamp: "2026-07-20T00:00:00Z",
+			customType: "note",
+			content: "x".repeat(contentBytes),
+			display: true,
+		} as unknown as SessionEntry);
+	}
+	return entries;
+}
+
+let host: CollabHost | undefined;
+
+beforeEach(() => {
+	AgentRegistry.resetGlobalForTests();
+	installInMemoryRelay();
+	host = undefined;
+});
+
+afterEach(async () => {
+	vi.useRealTimers();
+	if (host) await host.stop("test cleanup").catch(() => {});
+	uninstallInMemoryRelay();
+	AgentRegistry.resetGlobalForTests();
+});
+
+async function startHost(ctx: InteractiveModeContext): Promise<CollabSocket> {
+	const originalConnect = CollabSocket.prototype.connect;
+	let transport: CollabSocket | undefined;
+	const capture = spyOn(CollabSocket.prototype, "connect").mockImplementation(function (this: CollabSocket) {
+		transport = this;
+		return originalConnect.call(this);
+	});
+	host = new CollabHost(ctx);
+	try {
+		await host.start("ws://localhost:8788");
+	} finally {
+		capture.mockRestore();
+	}
+	if (!transport) throw new Error("host transport missing");
+	return transport;
+}
+
+/** Join one guest and return the welcome plus every entry of its snapshot train. */
+function join(transport: CollabSocket): { welcome: Extract<CollabFrame, { t: "welcome" }>; entries: SessionEntry[] } {
+	const send = spyOn(transport, "send").mockImplementation(() => {});
+	const batch = spyOn(transport, "sendBatch").mockImplementation(() => {});
+	transport.onFrame!({ t: "hello", proto: COLLAB_PROTO, name: "guest" }, 1);
+	const welcome = send.mock.calls
+		.map(([frame]) => frame)
+		.find(frame => typeof frame !== "string" && frame.t === "welcome");
+	if (!welcome || typeof welcome === "string" || welcome.t !== "welcome") throw new Error("no welcome sent");
+	const entries: SessionEntry[] = [];
+	for (const [frames] of batch.mock.calls) {
+		for (const frame of frames) {
+			const parsed = (typeof frame === "string" ? JSON.parse(frame) : frame) as CollabFrame;
+			if (parsed.t === "snapshot-chunk") entries.push(...(parsed.entries as SessionEntry[]));
+		}
+	}
+	send.mockRestore();
+	batch.mockRestore();
+	return { welcome, entries };
+}
+
+describe("collab join history", () => {
+	it("sends only the latest entries, re-rooted onto an omitted-history marker", async () => {
+		const transport = await startHost(makeCtx(chain(1000), { "collab.historyEntries": 300 }));
+		const { welcome, entries } = join(transport);
+		expect(entries).toHaveLength(301);
+		expect(welcome.entryCount).toBe(301);
+		const [marker, first] = entries;
+		expect(marker?.type).toBe("custom_message");
+		expect(marker && "customType" in marker ? marker.customType : undefined).toBe(COLLAB_HISTORY_OMITTED_CUSTOM_TYPE);
+		expect(marker?.parentId).toBeNull();
+		expect(first?.id).toBe("e700");
+		expect(first?.parentId).toBe(marker?.id);
+		expect(entries.at(-1)?.id).toBe("e999");
+		// Only the orphaned entry is rewritten; the rest keep their chain.
+		expect(entries[2]?.parentId).toBe("e700");
+	});
+
+	it("trims the tail further to the byte budget but always keeps the latest entry", async () => {
+		// 64 KiB entries: ~48 fit in the 3 MiB budget.
+		const transport = await startHost(makeCtx(chain(200, 64 * 1024), { "collab.historyEntries": 200 }));
+		const { entries } = join(transport);
+		expect(entries.length).toBeGreaterThan(10);
+		expect(entries.length).toBeLessThan(60);
+		expect(entries.at(-1)?.id).toBe("e199");
+	});
+
+	it("sends the full transcript without a marker when the limit is 0 or not reached", async () => {
+		const full = await startHost(makeCtx(chain(50), { "collab.historyEntries": 0 }));
+		expect(join(full).entries.map(entry => entry.id)).toEqual(chain(50).map(entry => entry.id));
+		await host?.stop("next");
+		const small = await startHost(makeCtx(chain(50)));
+		expect(join(small).entries).toHaveLength(50);
+	});
+});
