+describe("collab send coalescing", () => {
+	it("replaces a queued frame with the same key instead of queueing both", async () => {
+		const key = await crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
+		const socket = new CollabSocket({ wsUrl: "ws://localhost:8788/r/coalesce", role: "host", key });
+		// Never connected: everything stays queued.
+		socket.send({ t: "error", message: "head" });
+		socket.send({ t: "state", state: {} as never }, 0, "state");
+		socket.send({ t: "error", message: "between" });
+		socket.send({ t: "state", state: {} as never }, 0, "state");
+		socket.send({ t: "state", state: {} as never }, 0, "state");
+		expect(socket.pendingSendCount).toBe(3);
+		// A different target is a different stream.
+		socket.send({ t: "state", state: {} as never }, 2, "state");
+		expect(socket.pendingSendCount).toBe(4);
+		socket.close();
+	});
+});
