+
+/** The whole question and its numbered choices as terminal rows for the prompt body. */
+function promptContextChildren(question: string, choices: readonly HookEditorChoice[]): Component[] {
+	const children: Component[] = [];
+	for (const line of replaceTabs(sanitizeCarriageReturns(question)).trim().split("\n")) {
+		children.push(line.trim() ? new Text(theme.fg("accent", line), 0, 0) : new Spacer(1));
+	}
