+	choices.forEach((choice, index) => {
+		children.push(
+			new Text(`${theme.fg("dim", `${index + 1}.`)} ${theme.fg("text", flattenInline(choice.label))}`, 0, 0),
+		);
+		const description = choice.description ? flattenInline(choice.description) : "";
+		if (description) children.push(new Text(theme.fg("muted", description), 3, 0));
+	});
+	return children;
+}
+
+/** The question and its choices as markdown for native hosts. */
+function promptContextMarkdown(question: string, choices: readonly HookEditorChoice[]): string {
+	const list = choices.map((choice, index) => {
+		const description = choice.description ? flattenInline(choice.description) : "";
+		return `${index + 1}. ${flattenInline(choice.label)}${description ? ` — ${description}` : ""}`;
+	});
+	return `${replaceTabs(sanitizeCarriageReturns(question))}\n\n${list.join("\n")}`;
