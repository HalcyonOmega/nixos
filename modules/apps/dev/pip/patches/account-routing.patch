+/**
+ * Epoch ms at which `limit`'s window next resets, for reset-order routing. A
+ * window without a future reset clock (not yet started, or a stale report whose
+ * reset already passed) renews a full window from now. `Infinity` without a limit.
+ */
+export function windowResetOrderMs(limit: UsageLimit | undefined, nowMs: number, fallbackDurationMs: number): number {
+	if (!limit) return Number.POSITIVE_INFINITY;
+	const resetAt = windowResetAt(limit.window);
+	if (resetAt !== undefined && resetAt > nowMs) return resetAt;
+	const durationMs = limit.window?.durationMs;
+	return (
+		nowMs +
+		(durationMs !== undefined && Number.isFinite(durationMs) && durationMs > 0 ? durationMs : fallbackDurationMs)
+	);
+}
+
 /** Normalize a window’s used fraction for ranking. */
 export function normalizeUsageFraction(limit: UsageLimit | undefined): number {
 	const usedFraction = limit?.amount.usedFraction;
